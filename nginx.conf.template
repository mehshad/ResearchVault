# Generated from nginx.conf.template — do not edit this file directly.

# ── Production (port 80) ──────────────────────────────────────────────────────
server {
    listen 80;

    # Allow large uploads: CSV imports, document attachments, etc.
    client_max_body_size 50m;

    # /demo/* proxies to the demo app, keeping the full path so Express can
    # strip the prefix itself. All assets and API calls stay within this
    # location block — nothing leaks to the production app.
    location = /demo  { return 301 /demo/; }
    location /demo/ {
        proxy_pass         http://app-demo:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass         http://app:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 120s;
    }
}

# ── Demo direct access (port 8080, optional — only needed if you want
#    direct port access in addition to the /demo path above) ──────────────────
server {
    listen 8080;

    client_max_body_size 50m;

    location / {
        proxy_pass         http://app-demo:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 120s;
    }
}
