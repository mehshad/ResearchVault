# Generated from nginx.conf.template — do not edit this file directly.
# DEMO_PORT is injected by docker/nginx-entrypoint.sh at container start.

# ── Production (port 80) ──────────────────────────────────────────────────────
server {
    listen 80;

    # /demo and /demo/ redirect straight to the demo dashboard (no login needed).
    location = /demo  { return 302 http://$host:__DEMO_PORT__/app; }
    location = /demo/ { return 302 http://$host:__DEMO_PORT__/app; }

    location / {
        proxy_pass         http://app:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}

# ── Demo (port 8080 internally, exposed as DEMO_PORT on the host) ─────────────
server {
    listen 8080;

    location / {
        proxy_pass         http://app-demo:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
