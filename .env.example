# Copy this file to .env and customise before running setup.sh

# ── Authentication mode ───────────────────────────────────────────────────────
#
#  demo   No login required. A guest user is auto-injected. Good for trials.
#  local  Username + password stored in the application database.
#  ldap   Authenticate against LDAP / Active Directory.
#  oidc   Authenticate via any OpenID Connect provider (Azure AD, Okta, Google…).
#
AUTH_MODE=local

# ── Demo mode options (AUTH_MODE=demo) ───────────────────────────────────────
# Customise the auto-injected demo user shown in the UI.
# DEMO_USERNAME=demo.user
# DEMO_NAME=Demo User
# DEMO_EMAIL=demo@researchvault.local
# DEMO_ROLE=Management

# ── LDAP / Active Directory (AUTH_MODE=ldap) ─────────────────────────────────
# LDAP_URL=ldap://ldap.hospital.org:389
# LDAP_BIND_DN=cn=svc-researchvault,ou=service-accounts,dc=hospital,dc=org
# LDAP_BIND_PASSWORD=service-account-password
# LDAP_SEARCH_BASE=dc=hospital,dc=org
# LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
# LDAP_USER_FIELD_USERNAME=sAMAccountName
# LDAP_USER_FIELD_NAME=displayName
# LDAP_USER_FIELD_EMAIL=mail
# LDAP_TLS=false
# LDAP_TLS_REJECT_UNAUTHORIZED=true

# ── OpenID Connect / SSO (AUTH_MODE=oidc) ────────────────────────────────────
# Works with any OIDC-compatible provider:
#   Azure AD:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta:      https://<domain>.okta.com/oauth2/default
#   Google:    https://accounts.google.com
#   Keycloak:  https://keycloak.hospital.org/realms/<realm>
#
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://researchvault.hospital.org/api/auth/callback
# OIDC_SCOPE=openid profile email
# OIDC_PROVIDER_NAME=Hospital SSO
# Claim names that carry the user's identity in the ID token:
# OIDC_CLAIM_USERNAME=preferred_username
# OIDC_CLAIM_NAME=name
# OIDC_CLAIM_EMAIL=email

# ── Super Admin ──────────────────────────────────────────────────────────────
# The user whose login email matches this address is automatically promoted to
# superadmin on every login.  Set this before the first deployment.
# SUPER_ADMIN_EMAIL=admin@yourdomain.org

# ── Container runtime ────────────────────────────────────────────────────────
# Set to 'docker' or 'podman' to override auto-detection in setup.sh.
# Default: whichever is found first in PATH (docker wins over podman).
# CONTAINER_RUNTIME=docker

# ── Database ─────────────────────────────────────────────────────────────────
#
#  DB_TYPE    | DATABASE_URL format                                    | When to use
#  ───────────┼────────────────────────────────────────────────────────┼──────────────────────────────
#  postgres   | postgresql://user:pass@host:5432/dbname                | Production, multi-user
#  postgres   | postgresql://...neon.tech/dbname                       | Neon serverless cloud
#  sqlite     | sqlite:/data/sqlite/researchvault.db                   | Dev, edge, air-gapped deploys
#  mssql      | mssql://user:pass@host:1433/dbname                     | SQL Server / Azure SQL DB
#  mssql      | Server=host;Database=db;User Id=u;Password=p;Encrypt=true | ADO.NET / SQL farm
#
# Default: PostgreSQL via Docker (no DATABASE_URL needed — docker-compose sets it).
#
# ── SQLite ───────────────────────────────────────────────────────────────────
# To use SQLite:
#   docker compose -f docker-compose.yml -f docker-compose.sqlite.yml up -d
# DB_TYPE=sqlite
# DATABASE_URL=sqlite:/data/sqlite/researchvault.db
# SQLITE_DATA_DIR=/opt/researchvault/data/sqlite
#
# ── SQL Server / Azure SQL ───────────────────────────────────────────────────
# To use an existing SQL Server farm:
#   docker compose -f docker-compose.yml -f docker-compose.mssql.yml up -d
# Run migrations/mssql/0001_initial_schema.sql on the database first.
#
# URL style:
# DB_TYPE=mssql
# DATABASE_URL=mssql://researchvault_svc:StrongP%40ssword@sqlserver.hospital.org:1433/researchvault
#
# ADO.NET / connection-string style (copy from SQL Server Management Studio):
# DB_TYPE=mssql
# DATABASE_URL=Server=sqlserver.hospital.org;Database=researchvault;User Id=researchvault_svc;Password=StrongP@ssword;Encrypt=true;TrustServerCertificate=false
#
# For the bundled SQL Server container (dev/test only):
# SA_PASSWORD=StrongP@ssword1   (min 8 chars, uppercase + lowercase + digit + symbol)
# MSSQL_DATABASE=researchvault

# PostgreSQL password — only used when DB_TYPE=postgres (the default).
POSTGRES_PASSWORD=change-me

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-use-a-long-random-string

# ── Network ──────────────────────────────────────────────────────────────────
# APP_PORT is the internal Express port (default 5000). You do not normally need
# to change this — nginx (port 80) is the public-facing entry point.
# APP_PORT=5000

# Public URL — used for OIDC redirect URIs and file upload URLs.
# Set this to the hostname/IP your users will access (no trailing slash).
# With the default nginx deployment this is port 80, so omit the port.
APP_URL=http://localhost

# ── Storage paths (host machine) ─────────────────────────────────────────────
POSTGRES_DATA_DIR=/opt/researchvault/data/postgres
UPLOADS_DATA_DIR=/opt/researchvault/data/uploads

# ── Demo instance ─────────────────────────────────────────────────────────────
# Host port the demo app is exposed on.
# http://localhost/demo  → redirects to http://localhost:DEMO_PORT/
# http://localhost:DEMO_PORT  → direct demo access
DEMO_PORT=8080
DEMO_APP_URL=http://localhost:8080
